pkgname=wargo-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Single-binary homelab dashboard: metrics, processes, containers, terminal, files, updates"
arch=('x86_64' 'aarch64')
url="https://github.com/kushalpandya/wargo"
license=('AGPL-3.0-only')
depends=('pam' 'systemd')
optdepends=('docker: container management' 'sudo: on-demand admin actions' 'tmux: persistent terminals' 'pacman-contrib: unprivileged update checks')
provides=('wargo')
conflicts=('wargo')
backup=('etc/wargo/config.toml' 'etc/pam.d/wargo')
source_x86_64=("$url/releases/download/v$pkgver/wargo_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/wargo_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 wargo "$pkgdir/usr/bin/wargo"
  install -Dm755 wargo-privd "$pkgdir/usr/bin/wargo-privd"
  install -Dm644 deploy/pam/wargo "$pkgdir/etc/pam.d/wargo"
  install -Dm640 config.example.toml "$pkgdir/etc/wargo/config.toml"
  sed 's#/usr/local/bin/wargo#/usr/bin/wargo#' deploy/systemd/wargo@.service | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/wargo@.service"
  install -Dm644 deploy/systemd/wargo-privd.service "$pkgdir/usr/lib/systemd/system/wargo-privd.service"
  install -Dm644 deploy/systemd/wargo-privd.socket "$pkgdir/usr/lib/systemd/system/wargo-privd.socket"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
